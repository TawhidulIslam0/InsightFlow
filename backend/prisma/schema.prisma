generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  analyses     Analysis[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Analysis {
  id         String   @id @default(cuid())
  title      String
  text       String
  sentiment  String
  confidence Float
  topics     Json
  summary    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
